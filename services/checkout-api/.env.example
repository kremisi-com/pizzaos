DATABASE_URL=postgresql://pizzaos:replace_me@127.0.0.1:5432/pizzaos
# test rejects Stripe live keys; production must use a separate database and secrets.
PIZZAOS_ENVIRONMENT=test
AUTH_SECRET=replace_with_random_secret_at_least_32_characters
# Optional: enables poc@pizzaos.app. Leave empty to disable demo access.
PIZZAOS_DEMO_PASSWORD=
PIZZAOS_PROXY_SECRET=replace_with_another_random_secret_at_least_32_characters
PIZZAOS_ALLOWED_ORIGINS=http://127.0.0.1:3001,http://127.0.0.1:3002
# D71: include both https://admin.pizzaos.app and https://rider.pizzaos.app in production,
# plus the exact client origin. Keep test and production credentials/databases separate.
PIZZAOS_SUPERADMIN_EMAILS=owner@example.com
AUTH_GOOGLE_ID=replace_with_google_oauth_client_id
AUTH_GOOGLE_SECRET=replace_with_google_oauth_client_secret
SMTP_URL=smtp://username:password@mail.example.com:587
AUTH_EMAIL_FROM=PizzaOS <accesso@example.com>
# Email operative: test e allowlist vuota sono il default anche in produzione.
# Live richiede PIZZAOS_ENVIRONMENT=production e attivazione esplicita.
OPERATIONAL_EMAIL_MODE=test
OPERATIONAL_EMAIL_TEST_RECIPIENTS=
# Lasciare vuote per riusare SMTP_URL / AUTH_EMAIL_FROM del servizio.
OPERATIONAL_SMTP_URL=
OPERATIONAL_EMAIL_FROM=
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
PAYMENT_RESERVATION_MINUTES=10
# Opzionale: chiave OpenCage per la ricerca indirizzi sede in Profilo.
OPENCAGE_API_KEY=
PORT=3004
HOST=127.0.0.1
