{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm build:vercel",
  "outputDirectory": "public",
  "regions": ["fra1"],
  "git": { "deploymentEnabled": { "main": true, "*": false } },
  "functions": { "api/index.mjs": { "maxDuration": 300, "memory": 1024 } },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "daemons": {
    "reconciliation": {
      "root": "../..",
      "entrypoint": "services/checkout-api/Dockerfile.worker",
      "instances": { "fra1": 0 },
      "resources": { "requests": { "memory": "1Gi" } },
      "terminationGracePeriodSeconds": 50,
      "livenessProbe": {
        "httpGet": { "port": 3005, "path": "/health" },
        "initialDelaySeconds": 10
      }
    }
  }
}
